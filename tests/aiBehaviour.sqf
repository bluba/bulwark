/* Hosted editor/server only, mission functions + LAMBS loaded, idle mission loop.
   [] execVM "tests\aiBehaviour.sqf";
   Calls the real controller and object script. No simulation/mocks.
   Dedicated-server and HC transfer/takeover still require a multiplayer session. */
if (!isServer || {!canSuspend} || {isNull player} || {!alive player}) exitWith {};
if (missionNamespace getVariable ["runMissionLoop", false]) exitWith {diag_log "AI tests require an idle mission loop"};
if (isNil "lambs_wp_fnc_taskRush") exitWith {diag_log "AI tests require LAMBS"};
private _names = ["runMissionLoop", "missionExtract", "buildPhase", "attkWave"];
private _saved = _names apply {[!isNil _x, missionNamespace getVariable [_x, false]]};
runMissionLoop = true; missionExtract = false; buildPhase = false; attkWave = 999;
BW_aiFailures = [];
private _check = {params ["_ok", "_label"]; if (!_ok) then {BW_aiFailures pushBack _label; diag_log ("FAIL: " + _label)}};
private _group = createGroup [east, true];
private _unit = _group createUnit ["O_Soldier_F", player getPos [100, 0], [], 0, "NONE"];
removeAllWeapons _unit;
_unit allowDamage false;
_group setVariable ["bw_baseMode", "creep", true];
[_group, 999] call bulwark_fnc_controlEnemyGroup;
[(_group getVariable ["bw_aiMode", ""]) == "creep", "creep mode actually selected"] call _check;
private _oldTask = _group getVariable ["bw_taskHandle", scriptNull];
_unit setPosATL (player getPos [5, 0]);
[_group, 999] call bulwark_fnc_controlEnemyGroup;
[group _unit == _group, "reset preserves group identity"] call _check;
[scriptDone _oldTask, "previous task terminated"] call _check;
[(_group getVariable ["bw_aiMode", ""]) == "CQB", "CQB entry"] call _check;
private _cqbTask = _group getVariable ["bw_taskHandle", scriptNull];
_unit setPosATL (player getPos [15, 0]);
[_group, 999] call bulwark_fnc_controlEnemyGroup;
[(_group getVariable ["bw_aiMode", ""]) == "CQB" && {(_group getVariable ["bw_taskHandle", scriptNull]) isEqualTo _cqbTask}, "CQB hysteresis retains same task"] call _check;
_unit setPosATL (player getPos [30, 0]);
[_group, 999] call bulwark_fnc_controlEnemyGroup;
[(_group getVariable ["bw_aiMode", ""]) == "creep", "CQB exit restores base mode"] call _check;
_unit setVariable ["bw_suicideBomber", true];
[_group, 999] call bulwark_fnc_controlEnemyGroup;
[(_group getVariable ["bw_aiMode", ""]) == "suicide" && {scriptDone (_group getVariable ["bw_taskHandle", scriptNull])}, "bomber has no LAMBS task"] call _check;
_unit setVariable ["bw_suicideBomber", false];
_group setVariable ["bw_scriptedMovement", true];
[!([_group] call bulwark_fnc_enemyGroupAllowed), "scripted transport group protected"] call _check;
_group setVariable ["bw_scriptedMovement", false];
_unit setVariable ["BIS_fnc_moduleRemoteControl_owner", player];
[!([_group] call bulwark_fnc_enemyGroupAllowed), "Zeus-controlled group protected"] call _check;
_unit setVariable ["BIS_fnc_moduleRemoteControl_owner", nil];
// Object controller: singleton, pause while held, ordinary unit survival, tagged bomber.
private _box = createVehicle ["Land_Can_V3_F", player getPos [200, 0], [], 0, "NONE"];
_box setVariable ["Radius", 3];
_box setVariable ["buildItemHeld", true];
_unit disableAI "MOVE";
_unit setPosATL (getPosATL _box);
_unit allowDamage true;
_group setVariable ["bw_scriptedMovement", true];
sleep 2;
private _one = [_box] execVM "bulwark\solidobject.sqf";
private _two = [_box] execVM "bulwark\solidobject.sqf";
sleep 1;
[scriptDone _one && {scriptDone _two} && {!scriptDone (missionNamespace getVariable ["BW_OBSTACLE_JOB", scriptNull])}, "registrations finish; shared worker remains active"] call _check;
[({ _x == _box } count (missionNamespace getVariable ["BW_OBSTACLE_OBJECTS", []])) == 1, "repeat placement registers object once"] call _check;
_box setVariable ["buildItemHeld", false];
sleep 1;
[alive _unit && {!isNull _box}, "ordinary enemy does not detonate defense"] call _check;
_box setVariable ["buildItemHeld", true];
_unit setVariable ["bw_suicideBomber", true];
sleep 1;
[alive _unit && {!isNull _box}, "held defense pauses bomber trigger"] call _check;
_box setVariable ["buildItemHeld", false];
sleep 1;
[!alive _unit && {isNull _box}, "tagged bomber destroys placed defense"] call _check;
buildPhase = true;
sleep 2;
{private _h = _group getVariable [_x, scriptNull]; if (!scriptDone _h) then {terminate _h}} forEach ["bw_taskHandle", "bw_taskWatch"];
{if (!scriptDone _x) then {terminate _x}} forEach [_one, _two];
deleteVehicle _unit; deleteVehicle _box; deleteGroup _group;
{private _value = _saved select _forEachIndex; if (_value select 0) then {missionNamespace setVariable [_x, _value select 1]} else {missionNamespace setVariable [_x, nil]}} forEach _names;
diag_log format ["AI regression failures: %1", BW_aiFailures];

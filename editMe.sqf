/*New feature added: Point Bank!!
 This variable holds the amount of kill point deposited by the players
*/
POINT_BANK_INIT_AMOUNT 		   = ("POINT_BANK_INIT_AMOUNT" call BIS_fnc_getParamValue);
MAX_POINT_BANK_DEPOSIT_AMOUNT  = ("MAX_POINT_BANK_DEPOSIT_AMOUNT" call BIS_fnc_getParamValue);
MAX_POINT_BANK_WITHDRAW_AMOUNT = ("MAX_POINT_BANK_WITHDRAW_AMOUNT" call BIS_fnc_getParamValue);

/* Variable to check category open*/
CAT_OPEN = 0;

if (serverCommandAvailable "#logout") then {playerAdmin = player; publicVariable "playerAdmin";};

/* Attacker Waves */

// Intermission ready vote. The final 15-second warning always remains.
BW_READY_VOTE_ENABLED = true;
BW_READY_MIN_PREP = 15;

// Complete waves without a FOB between successful deployments (7 -> 10 with 2).
// FOBs remain eligible from wave 7 onward; at most one may be active or setting up.
BW_FOB_COOLDOWN_WAVES = 2;

// Officer Hunt: small infantry command post; never stacks with an enemy FOB.
BW_OFFICER_ENABLED = true;
// FPV Operator: optional Ukraine FPV Drone addon; missing addon skips selection.
BW_FPV_ENABLED = true;
BW_FPV_LOG = true; // Verbose server RPT diagnostics.
BW_FPV_MIN_WAVE = 10;
BW_FPV_COOLDOWN = 2;
BW_FPV_GUARDS = 2;
BW_FPV_CAP = 2;
BW_FPV_START_LIMIT = 10;
BW_FPV_LIFETIME = 480;
BW_FPV_DRONE_LIFETIME = 90;
BW_FPV_FIRST_DELAY = 30;
BW_FPV_INTERVAL_MIN = 35;
BW_FPV_INTERVAL_MAX = 50;
BW_FPV_TARGET_COOLDOWN = 20;
BW_FPV_SETUP_TIMEOUT = 30;
// Optional explicit ATL site list: BW_FPV_SITES = [[x,y,0], ...]; [] disables placement.
BW_OFFICER_MIN_WAVE = 10;
BW_OFFICER_COOLDOWN_WAVES = 2;
BW_OFFICER_GUARDS = 4;
BW_OFFICER_TEAM_SIZE = 4;
BW_OFFICER_TEAM_CAP = 2;
BW_OFFICER_INTERVAL = 90;
BW_OFFICER_TIMEOUT = 60;
BW_OFFICER_LIFETIME = 600;
BW_OFFICER_CLASSES = ["O_officer_F"];
BW_OFFICER_DEFECTOR_CLASSES = ["B_officer_F"];

// F15: optional, finite medical cache; independent of ordinary loot and hostiles.
BW_SUPPLY_ENABLED = true;
BW_SUPPLY_CHANCE = 0.20; // One independent roll per combat wave, including wave one.
BW_SUPPLY_CLASS = "Box_NATO_Equip_F";
BW_SUPPLY_STOCK = [["FirstAidKit", 6], ["Medikit", 1]];
BW_SUPPLY_LIFETIME = 180;
BW_SUPPLY_RELOCATION = 75;
// Both cache families arrive like the Supply Drop support.
BW_SUPPLY_AIRCRAFT = "B_T_VTOL_01_vehicle_F";
BW_SUPPLY_DELIVERY_TIMEOUT = 180;
BW_SUPPLY_DESCENT_TIMEOUT = 120;

// Independent engineering-family roll; lifetime/relocation settings above are shared.
BW_ENGINEERING_ENABLED = true;
BW_ENGINEERING_CHANCE = 0.20;
BW_ENGINEERING_CLASS = "Box_NATO_Equip_F";
BW_ENGINEERING_AP_POOL = ["APERSMine_Range_Mag", "APERSBoundingMine_Range_Mag", "APERSTripMine_Wire_Mag"];
BW_ENGINEERING_AT_POOL = ["ATMine_Range_Mag", "SLAMDirectionalMine_Wire_Mag"];
BW_ENGINEERING_GRENADE_POOL = ["HandGrenade", "MiniGrenade"];
BW_ENGINEERING_SMOKE_POOL = ["SmokeShell"];
BW_ENGINEERING_TOOLS = ["MineDetector", "ToolKit"]; // Remove ToolKit if native repair is unavailable in your mod/role setup.
BW_ENGINEERING_AP_COUNT = [1, 2];
BW_ENGINEERING_AT_COUNT = [1, 2];
BW_ENGINEERING_GRENADE_COUNT = [1, 3];


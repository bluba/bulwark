OPFORMODE = ("OPFOR_MODE" call BIS_fnc_getParamValue);

HOSTILE_LEVEL_1 = List_Bandits;//List_Bandits + List_ParaBandits;  // Wave 0 >
HOSTILE_LEVEL_2 = List_OPFOR;//List_OPFOR + List_INDEP;    // Wave 5 >
HOSTILE_LEVEL_3 = List_Viper;//List_Viper;    // Wave 10 >
HOSTILE_SUICIDE = List_Bandits;
HOSTILE_ARMED_CARS = List_ArmedCars;//List_Armour;//expects vehicles
HOSTILE_ARMOUR = List_Armour;//List_ArmedCars; //expects vehicles
HOSTILE_HELI = List_Helis;//List_Helis; //expects vehicles
DEFECTOR_INF = List_NATO;
DEFECTOR_CARS = List_ArmedCars;
DEFECTOR_ARMOR = List_Armour;
DEFECTOR_HELI = List_DEFECTOR_HELI;

if(OPFORMODE == 2) then {
    BW_OFFICER_CLASSES = ["rhs_msv_officer"]; // Invalid/missing leader class falls back to this faction's infantry.
	HOSTILE_LEVEL_1 = List_RUSSIA_LVL_1;//List_Bandits + List_ParaBandits;  // Wave 0 >
	HOSTILE_LEVEL_2 = List_RUSSIA_LVL_2;//List_OPFOR + List_INDEP;    // Wave 5 >
	HOSTILE_LEVEL_3 = List_RUSSIA_LVL_3;//List_Viper;    // Wave 10 >
	HOSTILE_SUICIDE = List_SUICIDE_RUSSIA;
	HOSTILE_ARMED_CARS = List_RUSSIA_CARS;//List_Armour;//expects vehicles
	HOSTILE_ARMOUR = List_RUSSIA_ARMOR;//List_ArmedCars; //expects vehicles
	HOSTILE_HELI = LIST_RUSSIA_HELI;//List_Helis; //expects vehicles
	DEFECTOR_INF = List_DEFECTOR_INF;
	DEFECTOR_CARS = List_DEFECTOR_CARS;
	DEFECTOR_ARMOR = List_DEFECTOR_ARMOR;
	DEFECTOR_HELI = List_DEFECTOR_HELI;
};

HOSTILE_MULTIPLIER = ("HOSTILE_MULTIPLIER" call BIS_fnc_getParamValue) / 100;  // How many hostiles per wave (waveCount x HOSTILE_MULTIPLIER)
HOSTILE_TEAM_MULTIPLIER = ("HOSTILE_TEAM_MULTIPLIER" call BIS_fnc_getParamValue) / 100;   // How many extra units are added per player
PISTOL_HOSTILES = ("PISTOL_HOSTILES" call BIS_fnc_getParamValue);  //What wave enemies stop only using pistols

/* LOCATION LIST OPTIONS */
// List_AllCities - for any random City
// List_SpecificPoint - will start the mission on the "Specific Bulwark Pos" marker (move with mission editor). Location must meet BULWARK_LANDRATIO and LOOT_HOUSE_DENSITY, BULWARK_MINSIZE, etc requirements
// List_LocationMarkers - for a location selected randomly from the Bulwark Zones in editor (Currently broken)
// *IMPORTANT* If you get an error using List_SpecificPoint it means that there isn't a building that qualifies. Turning down the "Minimum spawn room size" parameter might help.
// SPECIFIC, MARKERS
BULWARK_LOCATIONS = List_AllCities;
LOCATION_MODE = "DEFAULT";
_locationModeParam = ("LOCATION_MODE" call BIS_fnc_getParamValue); 
switch (_locationModeParam) do {
	case 1: { BULWARK_LOCATIONS = List_SpecificPoint;LOCATION_MODE="SPECIFIC"};
	case 2: { BULWARK_LOCATIONS = List_LocationMarkers;LOCATION_MODE="MARKERS"};
	default { BULWARK_LOCATIONS = List_AllCities;};
};
diag_log "LOC CHOICE";



BULWARK_RADIUS = ("BULWARK_RADIUS" call BIS_fnc_getParamValue);
BULWARK_MINSIZE = ("BULWARK_MINSIZE" call BIS_fnc_getParamValue);   // Spawn room must be bigger than x square metres
BULWARK_LANDRATIO = ("BULWARK_LANDRATIO" call BIS_fnc_getParamValue);
LOOT_HOUSE_DENSITY = ("LOOT_HOUSE_DENSITY" call BIS_fnc_getParamValue);

PLAYER_STARTWEAPON = if ("PLAYER_STARTWEAPON" call BIS_fnc_getParamValue == 1) then {true} else {false};
PLAYER_STARTMAP    = if ("PLAYER_STARTMAP" call BIS_fnc_getParamValue == 1) then {true} else {false};
PLAYER_STARTNVG    = if ("PLAYER_STARTNVG" call BIS_fnc_getParamValue == 1) then {true} else {false};

/* Respawn */
RESPAWN_TIME = ("RESPAWN_TIME" call BIS_fnc_getParamValue);
